# SHACL shapes for energy point entities (cube observations use sdc-rdf's core shapes).
@prefix sh:      <http://www.w3.org/ns/shacl#> .
@prefix sdce:    <https://w3id.org/sdc/ns/energy#> .
@prefix sdc:     <https://w3id.org/sdc/ns#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix geo:     <http://www.opengis.net/ont/geosparql#> .
@prefix org:     <http://www.w3.org/ns/org#> .

sdce:PowerFacilityShape a sh:NodeShape ;
    sh:targetClass sdce:PowerPlant, sdce:Substation ;
    sh:property [ sh:path dcterms:identifier ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path rdfs:label ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path sdce:inCounty ; sh:class sdc:County ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path geo:hasGeometry ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path sdce:operatingStatus ; sh:class sdce:OperatingStatus ; sh:maxCount 1 ] .

sdce:PowerPlantShape a sh:NodeShape ;
    sh:targetClass sdce:PowerPlant ;
    sh:property [ sh:path sdce:operatingCapacityMW ; sh:datatype xsd:decimal ; sh:minInclusive 0 ; sh:maxCount 1 ] ;
    sh:property [ sh:path sdce:primaryFuel ; sh:class sdce:EnergySource ; sh:maxCount 1 ] ;
    sh:property [ sh:path sdce:operatedBy ; sh:class org:Organization ] .

sdce:SubstationShape a sh:NodeShape ;
    sh:targetClass sdce:Substation ;
    sh:property [ sh:path sdce:maxVoltageKV ; sh:datatype xsd:decimal ; sh:minExclusive 0 ; sh:maxCount 1 ] ;
    sh:property [ sh:path sdce:lineCount ; sh:datatype xsd:integer ; sh:minInclusive 0 ; sh:maxCount 1 ] .

sdce:GeometryShape a sh:NodeShape ;
    sh:targetObjectsOf geo:hasGeometry ;
    sh:property [ sh:path geo:asWKT ; sh:datatype geo:wktLiteral ; sh:minCount 1 ; sh:maxCount 1 ] .

sdce:EVChargingLocationShape a sh:NodeShape ;
    sh:targetClass sdce:EVChargingLocation ;
    sh:property [ sh:path dcterms:identifier ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path sdce:inCounty ; sh:class sdc:County ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path geo:hasGeometry ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path sdce:locationType ; sh:class sdce:EVLocationType ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path sdce:typicalDayEnergyKWh ; sh:datatype xsd:decimal ; sh:minInclusive 0 ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path sdce:activeHours ; sh:datatype xsd:integer ; sh:minInclusive 0 ; sh:maxInclusive 24 ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path sdce:atStation ; sh:class sdce:EVChargingStation ; sh:maxCount 1 ] .

# Station nodes are minted by EVChargingDemand too (identifier only); full
# station attributes are checked by EVChargingStationRecordShape, which targets
# stations that have charger groups (i.e. come from EVChargingStations).
sdce:EVChargingStationShape a sh:NodeShape ;
    sh:targetClass sdce:EVChargingStation ;
    sh:property [ sh:path dcterms:identifier ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ] .

sdce:EVChargingStationRecordShape a sh:NodeShape ;
    sh:targetSubjectsOf sdce:hasChargerGroup ;
    sh:property [ sh:path rdfs:label ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path sdce:inCounty ; sh:class sdc:County ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path geo:hasGeometry ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path sdce:hasChargerGroup ; sh:class sdce:ChargerGroup ; sh:minCount 1 ] .

sdce:ChargerGroupShape a sh:NodeShape ;
    sh:targetClass sdce:ChargerGroup ;
    sh:property [ sh:path sdce:chargerLevel ; sh:class sdce:ChargerLevel ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path sdce:chargerCount ; sh:datatype xsd:integer ; sh:minInclusive 1 ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path dcterms:identifier ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ] .

sdce:ProjectedDataCenterShape a sh:NodeShape ;
    sh:targetClass sdce:ProjectedDataCenter ;
    sh:property [ sh:path dcterms:identifier ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path rdfs:label ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path sdce:inCounty ; sh:class sdc:County ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path geo:hasGeometry ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path sdc:scenario ; sh:class sdc:Scenario ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path sdc:refPeriod ; sh:datatype xsd:gYear ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path sdce:sourceId ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path sdce:itPowerMW ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path sdce:campusAreaSqFt ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path sdce:siteCostMillionUSD ; sh:minCount 1 ; sh:maxCount 1 ] .

sdce:CerfScenarioShape a sh:NodeShape ;
    sh:targetSubjectsOf sdce:growthTier ;
    sh:property [ sh:path sdce:growthTier ; sh:class sdce:GrowthTier ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path sdce:marketGravityWeight ; sh:datatype xsd:integer ; sh:minInclusive 0 ; sh:maxInclusive 100 ; sh:minCount 1 ; sh:maxCount 1 ] .
