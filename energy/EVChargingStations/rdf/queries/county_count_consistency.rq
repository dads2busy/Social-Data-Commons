# Cross-check: do the county cube's total_charger_count and total_station_count
# agree with the station nodes? Returns counties where either differs, including
# counties with published counts but no stations (expect zero rows;
# test_to_rdf.py asserts this).
PREFIX sdc:  <https://w3id.org/social-data-commons/ns#>
PREFIX sdce: <https://w3id.org/social-data-commons/ns/energy#>
PREFIX sdcm: <https://w3id.org/social-data-commons/measure/>

SELECT ?county ?publishedChargers ?chargers ?publishedStations ?stations WHERE {
  ?o1 sdc:refArea ?county ; sdcm:total_charger_count ?publishedChargers .
  ?o2 sdc:refArea ?county ; sdcm:total_station_count ?publishedStations .
  OPTIONAL {
    SELECT ?county (SUM(?n) AS ?c) (COUNT(DISTINCT ?st) AS ?s) WHERE {
      ?st a sdce:EVChargingStation ; sdce:inCounty ?county ;
          sdce:hasChargerGroup/sdce:chargerCount ?n .
    } GROUP BY ?county
  }
  BIND (COALESCE(?c, 0) AS ?chargers)
  BIND (COALESCE(?s, 0) AS ?stations)
  FILTER (?publishedChargers != ?chargers || ?publishedStations != ?stations)
}
