# Cross-check: for every (county, scenario), does projected_data_center_count
# equal the number of projected sites? Returns mismatches, including counts
# for which no sites exist at all (expect zero rows; test_to_rdf.py asserts this).
PREFIX sdc:  <https://w3id.org/social-data-commons/ns#>
PREFIX sdce: <https://w3id.org/social-data-commons/ns/energy#>
PREFIX sdcm: <https://w3id.org/social-data-commons/measure/>

SELECT ?county ?scenario ?published ?sites WHERE {
  ?obs sdc:refArea ?county ; sdc:scenario ?scenario ; sdcm:projected_data_center_count ?published .
  OPTIONAL {
    SELECT ?county ?scenario (COUNT(?site) AS ?n) WHERE {
      ?site a sdce:ProjectedDataCenter ; sdce:inCounty ?county ; sdc:scenario ?scenario .
    } GROUP BY ?county ?scenario
  }
  BIND (COALESCE(?n, 0) AS ?sites)
  FILTER (?published != ?sites)
}
